{
  "name": "mixspace-mcp",
  "version": "1.0.0",
  "description": "MCP server wrapping Mix Space CMS REST API into tools for LLMs",
  "type": "module",
  "main": "dist/mcp.js",
  "types": "dist/mcp.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "mixspace-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "mixspace", "cms", "llm"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
